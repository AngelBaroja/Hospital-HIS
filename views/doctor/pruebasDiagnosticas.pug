                button(type="button" class="btn-cerrar-modal") Aceptar
    script.
        document.addEventListener('DOMContentLoaded', () => {
            // Selecciona todos los formularios de estudios
            document.querySelectorAll('form[id^="formulario-"]').forEach(form => {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const action = form.getAttribute('action');
                    const modalId = form.getAttribute('data-modal');
                    const formData = new FormData(form);
                    const body = {};
                    formData.forEach((value, key) => body[key] = value);

                    try {
                        const res = await fetch(action, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(body)
                        });
                        const data = await res.json();
                        if (data.ok) {
                            // Mostrar el modal con la clase .visible
                            const modal = document.getElementById(modalId);
                            modal.classList.add('visible');
                        } else {
                            alert(data.error || 'No se pudo registrar el estudio');
                        }
                    } catch (err) {
                        alert('Error de conexión');
                    }
                });
            });

            // Cerrar modales al hacer click en el botón de cerrar
            document.querySelectorAll('.btn-cerrar-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    const modal = btn.closest('.modal-exito');
                    modal.classList.remove('visible');
                });
            });

            // Cerrar al hacer clic fuera del contenido
            document.querySelectorAll('.modal-exito').forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.classList.remove('visible');
                    }
                });
            });
        });