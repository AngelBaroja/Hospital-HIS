extends ../layout

block content   
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
        if cargo == "Doctor" || cargo == "Doctora"
            a.boton-alta(href=`/doctor/alta/${recepcion.id}`) Alta Médica
                img.icono-cruz(src="/img/hospital1.png", alt="Cruz médica")
    .pestanas3
        if cargo == "Enfermero" || cargo == "Enfermera"
            a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        if cargo == "Doctor" || cargo == "Doctora"
            a.pestana.activa5(href=`/doctor/estudios/${recepcion.id}`)  Estudios
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
        
    .contenido-pestana#recepcion        
        h2 Solicitud de Estudios Médicos
        p#texto Indica que estudio deseas realizarle al paciente y luego presiona el botón "Solicitar estudio" para registrar la solicitud.
        
        form#formulario-radiografia(data-modal="modalRadiografia" action=`/doctor/estudios/radiografia/${recepcion.id}` method="POST")
            .formulario-grid
                .grupo-formulario
                    h3 Radiografia : 
                    select(name="placa" required)
                        option(value="") Seleccione un estudio
                        each estudio in estudiosRadriograficos
                            option(value=estudio) #{estudio}
                        
                .grupo-formulario2                     
                    button.boton-solicitar(type="submit") Solicitar estudio
                    a.boton-verde2(href=`/doctor/radiografia/historial/${recepcion.id}`) Historial

        .modal-exito#modalRadiografia
            .modal-contenido
                img(src="/img/registros-medicos.ico" alt="Éxito")
                h2 ¡Radiografia realizada con éxito!
                p
                    | Paciente:                    
                    b #{recepcion.Paciente.nombre}  #{recepcion.Paciente.apellido}
                button(type="button" class="btn-cerrar-modal") Aceptar 
        
