extends ../../layout

block content   
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
        if cargo == "Doctor" || cargo == "Doctora"
            a.boton-alta(href=`/doctor/alta/${recepcion.id}`) Alta Médica
                img.icono-cruz(src="/img/hospital1.png", alt="Cruz médica")
    .pestanas3
        if cargo == "Enfermero" || cargo == "Enfermera"
            a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        if cargo == "Doctor" || cargo == "Doctora"
            a.pestana.activa5(href=`/doctor/estudios/${recepcion.id}`)  Estudios
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
    .contenido-pestana#recepcion
        h2 Historial de Tomografías

        if tomografias.length === 0
            .sin-analisis
                p No hay tomografías registradas para este paciente.
        else
            each tomografia, i in tomografias
                .hoja-analisis
                    img.icono-analisis(src="/img/tomografia-computarizada.png", alt=`Logo Tomografía`, style="width: 90px;")

                    .hoja-encabezado
                        img.logo-hospital(src="/img/Logo-Hospital1.jpg", alt="Logo del Hospital")
                        h3.nombre-hospital HIS HOSPITAL

                    .hoja-cuerpo
                        .hoja-detalle
                            h4 Paciente: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido} / #{recepcion.Paciente.dni}
                            h4 Fecha: #{tomografia.fecha_formateada} / Hora: #{tomografia.createdAt.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'})}
                            h4 Tipo de Estudio: #{tomografia.tipo}
                            img.imagen-analisis(src=tomografia.ruta, alt=`Tomografía ${tomografia.tipo}`)
                            p Resultado:
                            pre.informe #{tomografia.informacion}

                if i < tomografias.length - 1
                    hr.separador-analisis

        .botones-accion
            form(action=`/doctor/estudios/${recepcion.id}` method="GET")            
                button(type="submit" class="boton boton-secundario") Atrás
