extends ../layout

block content   
    .pestanas
        a.pestana.activa5(href='/administrador/doctores') Doctores
        a.pestana.activa5(href='/administrador/enfermeros') Enfermeros
        a.pestana.activa5(href='/administrador/administradores') Administradores
        a.pestana.activa5(href='/administrador/recepcionistas') Recepcionistas
    .pestanas3 
        a.pestana.activa5(href="/administrador/doctores")  Generar Doctor        
        a.pestana.activa5(href="/administrador/listar/doctores")  Listar Doctores  
    .contenido-pestana#doctor
        h2 Lista de Doctores
        if cartel
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Doctor modificado con éxito!                  
                    p
                        | Doctor:                    
                        b #{doctor.nombre}  #{doctor.apellido}                        
                    button(type="button" class="btn-cerrar-modal") Aceptar   
        table.tabla-turnos
            thead
                tr
                    th DNI
                    th Nombre y Apellido                    
                    th Contacto
                    th Especialidad
                    th Direccion                    
                    th Localidad
                    th Usuario
                    th Acciones
            tbody
                if doctores.length
                    each doctor in doctores
                        tr
                            td= doctor.dni
                            td= `${doctor.nombre} ${doctor.apellido}`                            
                            td= doctor.telefono
                            td= doctor.Especialidad.tipo
                            td= doctor.direccion                            
                            td= doctor.localidad
                            td= doctor.Usuario.usuario
                            td
                                form(action=`/administrador/listar/doctores/${doctor.id}` method="POST" style="display: inline;")
                                    if(doctor.activo==true)
                                        button.boton-eliminar(type="submit") Dar Baja
                                    else 
                                        button.boton-agregar(type="submit") Dar Alta
                else
                    tr
                        td(colspan="9") No hay Doctores cargados en HIS Hospital
        script.
            document.addEventListener('DOMContentLoaded', () => {
                        const modal = document.getElementById('modalExito');
                        if (modal) {
                            modal.classList.add('visible');
                            
                            document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                                modal.style.display = 'none';
                            });
                            
                            // Cerrar al hacer clic fuera del contenido
                            modal.addEventListener('click', (e) => {
                                if (e.target === modal) {
                                    modal.style.display = 'none';
                                }
                            });
                        }
                    });