extends ../layout

block content   
    .pestanas
        a.pestana.activa5(href='/administrador/doctores') Doctores
        a.pestana.activa5(href='/administrador/enfermeros') Enfermeros
        a.pestana.activa5(href='/administrador/administradores') Administradores
        a.pestana.activa5(href='/administrador/recepcionistas') Recepcionistas
    .pestanas3 
        a.pestana.activa5(href="/administrador/enfermeros")  Generar Enfermero        
        a.pestana.activa5(href="/administrador/listar/enfermeros")  Listar Enfermeros  
    .contenido-pestana#enfermero
        h2 Lista de Enfermeros
        if cartel
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Enfermero modificado con éxito!                  
                    p
                        | Enfermero:                    
                        b #{enfermero.nombre}  #{enfermero.apellido}                        
                    button(type="button" class="btn-cerrar-modal") Aceptar
        table.tabla-turnos
            thead
                tr
                    th DNI
                    th Nombre y Apellido                    
                    th Contacto
                    th Especialidad
                    th Direccion                    
                    th Localidad
                    th Usuario
                    th Acciones
            tbody
                if enfermeros.length
                    each enfermero in enfermeros
                        tr
                            td= enfermero.dni
                            td= `${enfermero.nombre} ${enfermero.apellido}`                            
                            td= enfermero.telefono
                            td= enfermero.Especialidad.tipo
                            td= enfermero.direccion                            
                            td= enfermero.localidad
                            td= enfermero.Usuario.usuario
                            td
                                form(action=`/administrador/listar/enfermeros/${enfermero.id}` method="POST" style="display: inline;")
                                    if(enfermero.activo==true)
                                        button.boton-eliminar(type="submit") Dar Baja
                                    else 
                                        button.boton-agregar(type="submit") Dar Alta
                else
                    tr
                        td(colspan="9") No hay Enfermeros cargados en HIS Hospital
        script.
            document.addEventListener('DOMContentLoaded', () => {
                        const modal = document.getElementById('modalExito');
                        if (modal) {
                            modal.classList.add('visible');
                            
                            document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                                modal.style.display = 'none';
                            });
                            
                            // Cerrar al hacer clic fuera del contenido
                            modal.addEventListener('click', (e) => {
                                if (e.target === modal) {
                                    modal.style.display = 'none';
                                }
                            });
                        }
                    });