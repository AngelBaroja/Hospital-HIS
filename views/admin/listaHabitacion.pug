extends ../layout

block content   
    .pestanas
        a.pestana.activa5(href='/administrador/camas') Camas
        a.pestana.activa5(href='/administrador/habitaciones') Habitaciones
    .pestanas3 
        a.pestana.activa5(href="/administrador/habitaciones") Generar Habitación       
        a.pestana.activa5(href="/administrador/listar/habitaciones")  Listar Habitaciones
        a.pestana.activa5(href="/administrador/insertar/cama")  Insertar Cama
        a.pestana.activa5(href="/administrador/mover/cama")  Mover Camas
    .contenido-pestana#recepcion
        h2 Formulario para la creacion de Habitaciones 
        p#texto Complete el formulario para generar una nueva Habitación.
        if cartel
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Habitación Eliminada con éxito!                  
                    p
                        | Número:                    
                        b #{habitacion.id} 
                    button(type="button" class="btn-cerrar-modal") Aceptar
        if cartel2
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Habitación Modificada con éxito!                  
                    
                    if habitacion.activa 
                        p La Habitación nº #{habitacion.id} fue activada.
                    else 
                        p La Habitación nº #{habitacion.id} fue dada de baja.
                    button(type="button" class="btn-cerrar-modal") Aceptar
        table.tabla-turnos
            thead
                tr
                    th Habitación nº
                    th Tipo                    
                    th Funcionando
                    th Ala
                    th Insertar
                    th Alta/Baja
                    th Eliminar
            tbody
                if habitaciones.length
                    each habitacion in habitaciones
                        tr
                            td= habitacion.id
                            td= habitacion.tipo
                            if habitacion.activa == true                          
                                td Si
                            else
                                td No
                            if habitacion.Ala
                                td= habitacion.Ala.sector
                            else
                                td Sin Sector
                            td
                                if habitacion.Camas.length == 0
                                    form(action=`/administrador/listar/habitaciones/${habitacion.id}` method="POST" style="display: inline;")
                                        button.boton-agregar(type="submit") Cama
                                else if habitacion.tipo === 'Compartida' && habitacion.Camas.length < 2
                                    if habitacion.Camas.some(cama => cama.estado === "Ocupada")
                                        | En Uso
                                    else
                                        form(action=`/administrador/listar/habitaciones/${habitacion.id}` method="POST" style="display: inline;")
                                            button.boton-agregar(type="submit") Cama
                                else if habitacion.Camas.some(cama => cama.estado === "Ocupada")
                                    | 
                            td 
                                if habitacion.Camas.some(cama => cama.estado === "Ocupada")
                                    | En Uso
                                else
                                    if habitacion.activa == false
                                        form(action=`/administrador/listar/habitaciones/activa/${habitacion.id}` method="POST" style="display: inline;")
                                            button.boton-agregar(type="submit") Activar
                                    else 
                                        form(action=`/administrador/listar/habitaciones/activa/${habitacion.id}` method="POST" style="display: inline;")
                                            button.boton-eliminar(type="submit") Dar Baja
                            td
                                if habitacion.Camas.some(cama => cama.estado === "Ocupada")
                                    | En Uso
                                else
                                    form(action=`/administrador/listar/habitaciones/eliminar/${habitacion.id}` method="POST" style="display: inline;")
                                        button.boton-eliminar(type="submit") Eliminar
                else
                    tr
                        td(colspan="9") No hay Habitaciones cargadas en HIS Hospital
        script.
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('modalExito');
                if (modal) {
                    modal.classList.add('visible');
                        
                    document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                        modal.style.display = 'none';
                    });
                        
                    // Cerrar al hacer clic fuera del contenido
                    modal.addEventListener('click', (e) => {
                        if (e.target === modal) {
                            modal.style.display = 'none';
                        }
                    });
                }
            });