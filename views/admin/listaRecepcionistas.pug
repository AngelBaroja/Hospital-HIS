extends ../layout

block content   
    .pestanas
        a.pestana.activa5(href='/administrador/doctores') Doctores
        a.pestana.activa5(href='/administrador/enfermeros') Enfermeros
        a.pestana.activa5(href='/administrador/administradores') Administradores
        a.pestana.activa5(href='/administrador/recepcionistas') Recepcionistas
    .pestanas3 
        a.pestana.activa5(href="/administrador/recepcionistas")  Generar Recepcionista        
        a.pestana.activa5(href="/administrador/listar/recepcionistas")  Listar Recepcionistas 
    .contenido-pestana#recepcionista
        h2 Lista de Recepcionistas
        if cartel
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Recepcionista modificado con éxito!                  
                    p
                        | Recepcionista:                    
                        b #{recepcionista.nombre}  #{recepcionista.apellido}                        
                    button(type="button" class="btn-cerrar-modal") Aceptar
        table.tabla-turnos
            thead
                tr
                    th DNI
                    th Nombre y Apellido                    
                    th Contacto
                    th Nacimiento
                    th Direccion                    
                    th Localidad
                    th Usuario
                    th Acciones
            tbody
                if recepcionistas.length
                    each recepcionista in recepcionistas
                        tr
                            td= recepcionista.dni
                            td= `${recepcionista.nombre} ${recepcionista.apellido}`                            
                            td= recepcionista.telefono
                            td= recepcionista.fecha_formateada 
                            td= recepcionista.direccion                            
                            td= recepcionista.localidad
                            td= recepcionista.Usuario.usuario
                            td
                                form(action=`/administrador/listar/recepcionistas/${recepcionista.id}` method="POST" style="display: inline;")
                                    if(recepcionista.activo==true)
                                        button.boton-eliminar(type="submit") Dar Baja
                                    else 
                                        button.boton-agregar(type="submit") Dar Alta
                else
                    tr
                        td(colspan="9") No hay Administradores cargados en HIS Hospital
        script.
            document.addEventListener('DOMContentLoaded', () => {
                        const modal = document.getElementById('modalExito');
                        if (modal) {
                            modal.classList.add('visible');
                            
                            document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                                modal.style.display = 'none';
                            });
                            
                            // Cerrar al hacer clic fuera del contenido
                            modal.addEventListener('click', (e) => {
                                if (e.target === modal) {
                                    modal.style.display = 'none';
                                }
                            });
                        }
                    });