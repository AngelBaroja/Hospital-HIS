extends ../layout

block content   
    .pestanas
        a.pestana.activa5(href='/administrador/camas') Camas
        a.pestana.activa5(href='/administrador/habitaciones') Habitaciones
    .pestanas3 
        a.pestana.activa5(href="/administrador/camas") Generar Cama       
        a.pestana.activa5(href="/administrador/listar/administradores")  Listar Camas           
    .contenido-pestana#recepcion
        h2 Lista de Camas
        if cartel
            .modal-exito#modalExito
                .modal-contenido
                    img(src="/img/aceptar.ico" alt="Éxito")
                    h2 ¡Cama eliminada con éxito!
                    p
                        | Cama ID : 
                        b #{cama.id}
                    button(type="button" class="btn-cerrar-modal") Aceptar 
        table.tabla-turnos
            thead
                tr
                    th ID
                    th Numero
                    th Tipo                    
                    th Estado
                    th Electrica
                    th Oxigeno                    
                    th Habitación Nº
                    th Ver 
                    th Eliminar
            tbody
                if camas.length
                    each cama in camas
                        tr
                            td= cama.id
                            td= cama.numero
                            td= cama.tipo                          
                            td= cama.estado
                            if cama.electrica 
                                td Si
                            else
                                td No                       
                            if cama.oxigeno 
                                td Si
                            else
                                td No
                            if cama.Habitacion 
                                td= cama.Habitacion.id
                            else 
                                td Sin Habitación                         
                            td
                                if cama.estado !== "Ocupada"
                                    form(action=`/administrador/listar/camas/${cama.id}` method="POST" style="display: inline;")
                                        button.boton-agregar(type="submit") Ver Cama
                                else 
                                    | En Uso
                            td
                                if cama.estado !== "Ocupada"
                                    form(action=`/administrador/listar/camas/eliminar/${cama.id}` method="POST" style="display: inline;")
                                        button.boton-eliminar(type="submit") Eliminar
                                else 
                                    | En Uso
                else
                    tr
                        td(colspan="9") No hay Camas cargadas en HIS Hospital
        script.
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('modalExito');
                if (modal) {
                    modal.classList.add('visible');
                        
                    document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                        modal.style.display = 'none';
                    });
                        
                    // Cerrar al hacer clic fuera del contenido
                    modal.addEventListener('click', (e) => {
                        if (e.target === modal) {
                            modal.style.display = 'none';
                        }
                    });
                }
            });