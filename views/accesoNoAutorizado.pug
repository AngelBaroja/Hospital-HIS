doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Error - Fallo al Navegar
    link(rel="stylesheet" href="/error.css")
  
  body
    .error-todo
      .error-imagen
        img(src="/img/exclamacion.png" alt="Error")
      
      .error-contenedor
        h1 Acceso No Autorizado
        .error-mensaje
          //p Lo sentimos, usted no tiene permisos para acceder a esta sección       
          if mensaje 
            p #{mensaje}
        a.login-boton(href="/home") Volver al home