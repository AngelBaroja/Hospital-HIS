extends ../layout

block content   
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
        if cargo == "Doctor" || cargo == "Doctora"
            a.boton-alta(href=`/doctor/alta/${recepcion.id}`) Alta Médica
                img.icono-cruz(src="/img/hospital1.png", alt="Cruz médica")
    .pestanas3
        if cargo == "Enfermero" || cargo == "Enfermera"
            a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        if cargo == "Doctor" || cargo == "Doctora"
            a.pestana.activa5(href=`/doctor/estudios/${recepcion.id}`)  Estudios
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
    
    .contenido-pestana#recepcion
        h2 Historial de Tratamientos
        table.tabla-turnos
            thead                
                tr
                    th Plan
                    th Detalle
                    th Fecha
                    th Hora
                    th Accion
            tbody 
                if recepcion.Paciente.Historial_Medico && recepcion.Paciente.Historial_Medico.Tratamientos.length !== 0
                    each plan in recepcion.Paciente.Historial_Medico.Tratamientos
                        tr
                            td= plan.tratamiento
                            if plan.detalle_tratamiento == ""
                                td Sin detalle
                            else 
                                td= plan.detalle_tratamiento
                            td= plan.fecha_formateada
                            td= plan.createdAt.toLocaleTimeString()
                            td
                                form(action=`/enfermeria/tratamiento/historial/${recepcion.id}/${plan.id}` method="POST" style="display: inline;")
                                    button.boton-eliminar(type="submit") Eliminar
                else
                    tr
                        td(colspan="7") No hay registro de Tratamientos al paciente #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido} / DNI : #{recepcion.Paciente.dni}
        .botones-accion
            a.boton.boton-secundario(href=`/enfermeria/sintomas/${recepcion.id}#tratamientos` ) Atrás
    if cartel
        .modal-exito#modalExito
            .modal-contenido
                img(src="/img/aceptar.ico" alt="Éxito")
                h2 ¡Tratamiento borrado con éxito!
                p
                    | Paciente:                    
                    b #{recepcion.Paciente.nombre}  #{recepcion.Paciente.apellido}
                button(type="button" class="btn-cerrar-modal") Aceptar
    script. 
         document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('modalExito');
            if (modal) {
                modal.classList.add('visible');
                
                document.querySelector('.btn-cerrar-modal').addEventListener('click', () => {
                    modal.style.display = 'none';
                });
                
                // Cerrar al hacer clic fuera del contenido
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });
            }
        });