extends ../../layout

block content 
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
    .pestanas3 
        a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
    .pestanas2
        a(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`).pestana-secundaria Alergias
        a(href=`/enfermeria/historialMedico/antecedentes/${recepcion.id}`).pestana-secundaria Antecedentes Familiares
        a(href=`/enfermeria/historialMedico/enfermedad/${recepcion.id}`).pestana-secundaria.activa Enfermedades Previas
        a(href=`/enfermeria/historialMedico/cirugia/${recepcion.id}`).pestana-secundaria Cirugias Previas
        a(href=`/enfermeria/historialMedico/medicamentos/${recepcion.id}`).pestana-secundaria Medicamentos
    
    .contenido-pestana#historial-medico
        h2 Historial Médico del Paciente || Enfermedades Previas
        p#texto Carga los datos sobre distintas las enfermedades que posea el paciente.

        form#formulario-registro(action=`/enfermeria/historialMedico/enfermedad/${recepcion.id}` method="POST")                    
            .formulario-grid
                .grupo-formulario
                    label(for="nombre_enfermedad") Nombre de la Enfermedad:
                    input(type="text" id="nombre_enfermedad"  placeholder="Ingrese el nombre de la enfermedad")
                .grupo-formulario
                    label(for="fecha_diagnostico") Fecha Diagnóstico:
                    input(type="date" id="fecha_diagnostico" placeholder="Ingrese la fecha en la que fue diagnosticada")
                .grupo-formulario
                    button(type="button" class="boton-agregar" onclick="agregarEnfermedadPrevia()") Agregar

            #enfermedades-cargadas
            if recepcion.Paciente.Historial_Medico && recepcion.Paciente.Historial_Medico.Enfermedad_Previa && recepcion.Paciente.Historial_Medico.Enfermedad_Previa.length > 0
                each enfermedad in recepcion.Paciente.Historial_Medico.Enfermedad_Previa
                    .bloque-historial
                        .formulario-grid
                            .grupo-formulario
                                label Nombre de la Enfermedad:
                                input(type="text" name="nombre_enfermedad" value=enfermedad.nombre_enfermedad readonly)
                            .grupo-formulario
                                label Fecha Diagnóstico:
                                input(type="date" name="fecha_diagnostico" value=enfermedad.fecha_diagnostico readonly)
                            .grupo-formulario
                            .grupo-formulario#quitar
                                button(type="button" class="boton-quitar" onclick="quitarEnfermedad(this)") Quitar

            .botones-accion
                .grupo-formulario 
                button(type="submit" class="boton boton-primario") Guardar

        form(action="/enfermeria/pacientesInternados" method="GET" style ="margin-top: -48px;")            
            button(type="submit" class="boton boton-secundario") Atrás
    if cartel
        .modal-exito#modalExito
            .modal-contenido
                img(src="/img/aceptar.ico" alt="Éxito")
                if recepcion.Paciente.Historial_Medico.Enfermedad_Previa.length > 1
                    h2 ¡#{recepcion.Paciente.Historial_Medico.Enfermedad_Previa.length} Enfermedades guardadas con éxito!
                if recepcion.Paciente.Historial_Medico.Enfermedad_Previa.length === 1 
                    h2 ¡Enfermedad guardada con éxito!
                else 
                    h2 Paciente sin Enfermedades guardado con éxito!
                p
                    | Paciente:                    
                    b #{recepcion.Paciente.nombre}  #{recepcion.Paciente.apellido}
                button(type="button" class="btn-cerrar-modal") Aceptar

    script(src="/scriptEnfermeria/historialMedico/scriptEnfermedades.js")