extends ../../layout

block content
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
    .pestanas3
        a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
    .pestanas2
        a(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`).pestana-secundaria.activa Alergias
        a(href=`/enfermeria/historialMedico/antecedentes/${recepcion.id}`).pestana-secundaria Antecedentes Familiares
        a(href=`/enfermeria/historialMedico/enfermedad/${recepcion.id}`).pestana-secundaria Enfermedades Previas
        a(href=`/enfermeria/historialMedico/cirugia/${recepcion.id}`).pestana-secundaria Cirugias Previas
        a(href=`/enfermeria/historialMedico/medicamentos/${recepcion.id}`).pestana-secundaria Medicamentos

    .contenido-pestana#historial-medico
        h2 Historial Médico del Paciente || Alergias
        p#texto Carga los datos sobre distintas las alergias que posea el paciente.
        form#formulario-registro(action=`/enfermeria/historialMedico/alergia/${recepcion.id}` method="POST")    
            .formulario-grid
                .grupo-formulario
                    label(for="alergia-nueva") Alergia:
                    input(type="text" id="alergia-nueva" placeholder="Ingrese sustancia alergica")
                .grupo-formulario
                    label(for="reaccion-nueva") Reacción:
                    input(type="text" id="reaccion-nueva" placeholder="Ingrese reacción alérgica")
                .grupo-formulario
                    label(for="severidad-nueva") Severidad:
                    select(id="severidad-nueva")
                        option(value="") Seleccione...
                        option(value="Leve") Leve
                        option(value="Moderada") Moderada
                        option(value="Severa") Severa
                    button(type="button" class="boton-agregar" onclick="agregarAlergia()") Agregar

            #alergias-cargadas
            if recepcion.Paciente.Historial_Medico && recepcion.Paciente.Historial_Medico.Alergia && recepcion.Paciente.Historial_Medico.Alergia.length > 0
                each alergia in recepcion.Paciente.Historial_Medico.Alergia
                    .bloque-historial                        
                        .formulario-grid
                            .grupo-formulario
                                label Alergia:
                                input(type="text" value=alergia.sustancia name="sustancia" readonly)
                            .grupo-formulario
                                label Reacción:
                                input(type="text" value=alergia.reaccion name="reaccion" readonly)
                            .grupo-formulario
                                label Severidad:
                                input(type="text" value=alergia.severidad name="severidad" readonly)
                            .grupo-formulario#quitar
                                button(type="button" class="boton-quitar" onclick="quitarAlergia(this)") Quitar

            .botones-accion 
                .grupo-formulario
                button(type="submit" class="boton boton-primario") Guardar
        form(action="/enfermeria/pacientesInternados" method="GET" style ="margin-top: -48px;")            
            button(type="submit" class="boton boton-secundario") Atrás    
    if cartel
        .modal-exito#modalExito
            .modal-contenido
                img(src="/img/aceptar.ico" alt="Éxito")
                if recepcion.Paciente.Historial_Medico.Alergia.length > 1
                    h2 ¡#{recepcion.Paciente.Historial_Medico.Alergia.length} Alergias guardadas con éxito!
                if recepcion.Paciente.Historial_Medico.Alergia.length === 1
                    h2 ¡Alergia guardada con éxito!
                else
                    h2 ¡Paciente sin Alergias guardado con éxito!
                p
                    | Paciente:                    
                    b #{recepcion.Paciente.nombre}  #{recepcion.Paciente.apellido}
                button(type="button" class="btn-cerrar-modal") Aceptar
    script(src="/scriptEnfermeria/historialMedico/scriptAlergia.js")
            