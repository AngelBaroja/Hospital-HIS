extends ../../layout

block content 
    .pestanas
        .pestana.activa4  Paciente Internado: #{recepcion.Paciente.nombre} #{recepcion.Paciente.apellido}
        if cargo == "Doctor" || cargo == "Doctora"
            a.boton-alta(href=`/doctor/alta/${recepcion.id}`) Alta Médica
                img.icono-cruz(src="/img/hospital1.png", alt="Cruz médica")
    .pestanas3
        if cargo == "Enfermero" || cargo == "Enfermera"
            a.pestana.activa5(href=`/enfermeria/registro/${recepcion.id}`)  Registro
        a.pestana.activa5(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`)  Historial Medico
        a.pestana.activa5(href=`/enfermeria/signosVitales/${recepcion.id}`)  Signos Vitales
        if cargo == "Doctor" || cargo == "Doctora"
            a.pestana.activa5(href=`/doctor/estudios/${recepcion.id}`)  Estudios
        a.pestana.activa5(href=`/enfermeria/sintomas/${recepcion.id}`)  Sintomas / Tratamiento
    .pestanas2
        a(href=`/enfermeria/historialMedico/alergia/${recepcion.id}`).pestana-secundaria Alergias
        a(href=`/enfermeria/historialMedico/antecedentes/${recepcion.id}`).pestana-secundaria.activa Antecedentes Familiares
        a(href=`/enfermeria/historialMedico/enfermedad/${recepcion.id}`).pestana-secundaria Enfermedades Previas
        a(href=`/enfermeria/historialMedico/cirugia/${recepcion.id}`).pestana-secundaria Cirugias Previas
        a(href=`/enfermeria/historialMedico/medicamentos/${recepcion.id}`).pestana-secundaria Medicamentos
    .contenido-pestana#historial-medico
        h2 Historial Médico del Paciente || Antecedentes Familiares
        p#texto Carga los datos sobre los distintos antecedentes de enfermedades familiares que posea el paciente.
        form#formulario-registro(action=`/enfermeria/historialMedico/antecedentes/${recepcion.id}` method="POST")
            .formulario-grid
                .grupo-formulario
                    label(for="enfermedad_familiar") Enfermedad Familiar:
                    input(type="text" id="enfermedad_familiar" placeholder="Ingrese la enfermedad del familiar")
                .grupo-formulario
                    label(for="parentesco") Parentesco:
                    select(id="parentesco")
                        option(value="") Seleccione...
                        each familia in familiares
                            option(value=familia)= familia
                .grupo-formulario
                    button(type="button" class="boton-agregar" onclick="agregarAntecedenteFamiliar()") Agregar

            #antecedentes-cargados
            if recepcion.Paciente.Historial_Medico && recepcion.Paciente.Historial_Medico.Antecedente_Familiars && recepcion.Paciente.Historial_Medico.Antecedente_Familiars.length > 0
                each antecedente in recepcion.Paciente.Historial_Medico.Antecedente_Familiars
                    .bloque-historial
                        .formulario-grid
                            .grupo-formulario
                                label Enfermedad Familiar:
                                input(type="text" name="enfermedad_familiar" value=antecedente.enfermedad_familiar readonly)
                            .grupo-formulario
                                label Parentesco:
                                input(type="text" name="parentesco" value=antecedente.parentesco readonly)                                
                            .grupo-formulario
                            .grupo-formulario#quitar
                                button(type="button" class="boton-quitar" onclick="quitarAntecedenteFamiliar(this)") Quitar

                                            
            .botones-accion             
                .grupo-Formulario 
                button(type="submit" class="boton boton-primario") Guardar

        form(action="/enfermeria/pacientesInternados" method="GET" style ="margin-top: -48px;")            
            button(type="submit" class="boton boton-secundario") Atrás
    if cartel
        .modal-exito#modalExito
            .modal-contenido
                img(src="/img/aceptar.ico" alt="Éxito")
                if recepcion.Paciente.Historial_Medico.Antecedente_Familiars.length > 1
                    h2 ¡#{recepcion.Paciente.Historial_Medico.Antecedente_Familiars.length} Antecedentes Familiares guardados con éxito!
                else if recepcion.Paciente.Historial_Medico.Antecedente_Familiars.length === 1
                    h2 ¡Antecedente Familiar guardado con éxito!
                else 
                    h2 ¡Paciente sin Antecedentes Familiar guardado con éxito!
                p
                    | Paciente:                    
                    b #{recepcion.Paciente.nombre}  #{recepcion.Paciente.apellido}
                button(type="button" class="btn-cerrar-modal") Aceptar
    script.
        var familiares = !{JSON.stringify(familiares)};
    script(src="/scriptEnfermeria/historialMedico/scriptAntecedentes.js")
            